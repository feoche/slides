{
  "name": "slidev-theme-feoche",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.16.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.16.0"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "aspectRatio": "16/9",
      "author": "François Eoche",
      "canvasWidth": 980,
      "comark": true,
      "drawings": {
        "enabled": true,
        "persist": false,
        "presenterOnly": false,
        "syncAll": true
      },
      "favicon": "https://media.licdn.com/dms/image/v2/D4E03AQFlxDzSI7rkNw/profile-displayphoto-shrink_100_100/B4EZSFJxsqHAAU-/0/1737400720626?e=1783555200&v=beta&t=X4ln1ga8xwnnMo6wHrTdlpoZlvYI-cqdcM-X6EX-AHI",
      "fonts": {
        "sans": "Albert Sans",
        "serif": "Outfit",
        "mono": "Cascadia Code"
      },
      "lineNumbers": true,
      "monaco": true,
      "monacoTypesSource": "local",
      "overviewSnapshots": false,
      "presenter": true,
      "routerMode": "history",
      "selectable": true,
      "titleTemplate": "François Eoche : %s",
      "transition": null,
      "twoslash": true
    }
  }
}